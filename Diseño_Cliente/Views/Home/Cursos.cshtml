
@{
    ViewBag.Title = "Cursos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<br />
<div class="alert alert-primary">
    <h3>CURSOS ELECTIVOS !</h3>
    <strong>Selecciona</strong> tu curso e inicia la clase.
</div>

<input type="hidden" id="idestudiante" name="name" value="@Session["IdEstudiante"]" />
<div class="container my-4">
    <div class="row g-4" id="contenedor"></div>
</div>
<table class="table table-bordered" id="tablaCursos">
    <thead>
        <tr>
            <th>ID</th>
            <th>Estudiante</th>
            <th>Estudiante apellido</th>
            <th>Asistente</th>
            <th>Asistente apellido</th>
            <th>Curso</th>
            <th>Dias habilitados</th>
            <th>Horario de inicio</th>
            <th>Horario de fin</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section scripts{
    <script>
        $(function () {
    const id = $("#idestudiante").val();

    $.getJSON('@Url.Action("Listar_Inscripciones", "Home")', { estudianteId: id })
        .done(function (datos) {

            const inscripciones = datos.jeason_lista ?? [];
            const tbody     = $("#tablaCursos tbody").empty();
            const container = $("#contenedor").empty();

            inscripciones.forEach(i => {
                tbody.append(`
                    <tr>
                        <td>${i.Id_Inscripcion}</td>
                        <td>${i.Estudiante_Id.Nombre_Estudiante}</td>
                        <td>${i.Estudiante_Id.Apellido_Estudiante}</td>
                        <td>${i.Asignacion_Id.Asistente_Id.Nombre_Usuario}</td>
                        <td>${i.Asignacion_Id.Asistente_Id.Apellido_Usuario}</td>
                        <td>${i.Asignacion_Id.Curso_Id.Nombre_Curso}</td>
                        <td>${i.Asignacion_Id.Dia_Asignacion}</td>
                        <td>${i.Asignacion_Id.Horario_Inicio_Asignacion}</td>
                        <td>${i.Asignacion_Id.Horario_Fin_Asignacion}</td>
                    </tr>`);

                const { Nombre_Usuario, Apellido_Usuario } = i.Asignacion_Id.Asistente_Id;
                const { Nombre_Curso } = i.Asignacion_Id.Curso_Id;
                const { Dia_Asignacion, Horario_Inicio_Asignacion, Horario_Fin_Asignacion } = i.Asignacion_Id;

                const card = `
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                  <div class="card shadow-sm h-100">
                    <img src="https://class.utp.edu.pe/static/media/courseP1.6604957d.png" class="card-img-top" alt="${Nombre_Curso}">
                    <div class="card-body">
                      <span class="btn btn-warning btn-sm">${Dia_Asignacion}</span>
                      <h5 class="card-title mt-3">${Nombre_Curso}</h5>
                      <p class="card-text text-muted mb-2">${Nombre_Usuario} ${Apellido_Usuario}</p>
                      <div class="text-secondary small">
                        ${Horario_Inicio_Asignacion} – ${Horario_Fin_Asignacion}
                      </div>
                    </div>
                  </div>
                </div>`;

                container.append(card);   // ← ahora sí se renderiza
            });
        })
        .fail((xhr, s, e) => console.error("AJAX error:", e));
});

    </script>
}